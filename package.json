{
  "name": "hob",
  "version": "1.0.0",
  "description": "A self-hosted personal assistant that runs real work as background jobs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FFatTiger/hob.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/boot.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx server/src/boot.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@hono/node-server": "^2.1.6",
    "@juicesharp/rpiv-config": "file:vendor/juicesharp-rpiv-config-2.15.0.tgz",
    "@juicesharp/rpiv-web-tools": "file:vendor/juicesharp-rpiv-web-tools-2.15.0.tgz",
    "@local/lore-pi-extension": "file:vendor/lore-pi-extension-1.12.4.tgz",
    "croner": "^9.0.0",
    "hono": "^4.6.0",
    "marked": "^15.0.0",
    "pi-memory": "file:vendor/pi-memory-0.4.2.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^8.12.3",
    "minimatch": "^11.0.4"
  }
}
